<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.playball.backend.notification.mapper.NotificationSettingMapper">

    <!-- 조회 -->
    <select id="findByMemberId"
            resultType="com.playball.backend.notification.dto.NotificationSettingDTO">
        SELECT member_id, enabled, updated_at
        FROM notification_setting
        WHERE member_id = #{memberId}
    </select>

    <!-- 새 설정 등록 -->
    <insert id="insertSetting"
            parameterType="com.playball.backend.notification.dto.NotificationSettingDTO">
        INSERT INTO notification_setting (member_id, enabled)
        VALUES (#{memberId}, #{enabled})
    </insert>

    <!-- 기존 설정 변경 -->
    <update id="updateEnabled">
        UPDATE notification_setting
        SET enabled = #{enabled}
        WHERE member_id = #{memberId}
    </update>

</mapper>