<mapper namespace="com.playball.member.mapper.MemberMapper">
    <!--  결과 매핑  -->
    <resultMap id="memberResultMap" type="com.playball.member.dto.MemberDTO">
        <id property="memberId" column="member_id"/>
        <result property="kakaoId" column="kakao_id"/>
        <result property="email" column="email"/>
        <result property="nickname" column="nickname"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="gender" column="gender"/>
        <result property="age" column="age"/>
        <result property="profileImage" column="profile_image"/>
        <result property="skillLevel" column="skill_level"/>
        <result property="preferredPosition" column="preferred_position"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="address" column="address"/>
        <result property="role" column="role"/>
        <result property="signupCompleted" column="signup_completed"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <!--  카카오 최초 로그인 시 회원 등록  -->
    <insert id="insertMember" parameterType="com.playball.member.dto.MemberDTO" useGeneratedKeys="true" keyProperty="memberId"> INSERT INTO member (kakao_id, email, nickname, name, profile_image, role, signup_completed) VALUES (#{kakaoId}, #{email}, #{nickname}, #{name}, #{profileImage}, #{role}, #{signupCompleted}) </insert>
    <!--  카카오 ID로 조회  -->
    <select id="findByKakaoId" resultMap="memberResultMap"> SELECT * FROM member WHERE kakao_id = #{kakaoId} </select>
    <!--  ID로 조회  -->
    <select id="findById" resultMap="memberResultMap"> SELECT * FROM member WHERE member_id = #{memberId} </select>
    <!--  이메일로 조회  -->
    <select id="findByEmail" resultMap="memberResultMap"> SELECT * FROM member WHERE email = #{email} </select>
    <!--  닉네임 중복 확인  -->
    <select id="countByNickname" resultType="int"> SELECT COUNT(*) FROM member WHERE nickname = #{nickname} </select>
    <!--  추가정보 입력 완료 (회원가입 완료)  -->
    <update id="completeSignup" parameterType="com.playball.member.dto.MemberDTO"> UPDATE member SET nickname = #{nickname}, gender = #{gender}, age = #{age}, address = #{address}, latitude = #{latitude}, longitude = #{longitude}, skill_level = #{skillLevel}, preferred_position = #{preferredPosition}, signup_completed = 1, updated_at = NOW() WHERE member_id = #{memberId} </update>
    <!--  회원 정보 수정  -->
    <update id="updateMember" parameterType="com.playball.member.dto.MemberDTO">
        UPDATE member
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="age != null">age = #{age},</if>
            <if test="profileImage != null">profile_image = #{profileImage},</if>
            <if test="skillLevel != null">skill_level = #{skillLevel},</if>
            <if test="preferredPosition != null">preferred_position = #{preferredPosition},</if>
            <if test="address != null">address = #{address},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            updated_at = NOW()
        </set>
        WHERE member_id = #{memberId}
    </update>
    <!--  프로필 이미지 수정  -->
    <update id="updateProfileImage"> UPDATE member SET profile_image = #{profileImage}, updated_at = NOW() WHERE member_id = #{memberId} </update>
    <!--  위치 정보 수정  -->
    <update id="updateLocation"> UPDATE member SET latitude = #{latitude}, longitude = #{longitude}, address = #{address}, updated_at = NOW() WHERE member_id = #{memberId} </update>
    <!--  회원 탈퇴  -->
    <delete id="deleteMember"> DELETE FROM member WHERE member_id = #{memberId} </delete>
    <!--  즐겨하는 종목 추가  -->
    <insert id="insertFavoriteSport"> INSERT INTO favorite_sport (member_id, sport_type) VALUES (#{memberId}, #{sportType}) </insert>
    <!--  즐겨하는 종목 전체 삭제  -->
    <delete id="deleteFavoriteSports"> DELETE FROM favorite_sport WHERE member_id = #{memberId} </delete>
    <!--  즐겨하는 종목 조회  -->
    <select id="findFavoriteSports" resultType="string"> SELECT sport_type FROM favorite_sport WHERE member_id = #{memberId} </select>
</mapper>